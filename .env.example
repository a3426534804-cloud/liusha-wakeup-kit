# Fill on YOUR machine. Never commit .env or live state/logs.
LIUSHA_RUNTIME_ROOT=/srv/liusha-runtime
LIUSHA_PROJECT_DIR=/srv/liusha-project
LIUSHA_CLAUDE_BIN=claude
LIUSHA_RELAY_DB=/srv/liusha-runtime/relay.db
LIUSHA_RELAY_URL=http://127.0.0.1:3011
LIUSHA_RELAY_TOKEN=
LIUSHA_DASHBOARD_TOKEN=
LIUSHA_PROTOCOL_FILE=/srv/liusha-runtime/protocol.txt
LIUSHA_MCP_CONFIG=/srv/liusha-runtime/chat-mcp.json
LIUSHA_ALLOWED_TOOLS=CronList,CronDelete
LIUSHA_UPLOAD_DIR=/srv/liusha-runtime/uploads
LIUSHA_ACTIVE_PID_FILE=/srv/liusha-runtime/state/active.pid
LIUSHA_CALL_LOCK=/srv/liusha-runtime/state/model-call.lock
LIUSHA_ENV_FILE=/srv/liusha-runtime/.env
LIUSHA_FLAGS_FILE=/srv/liusha-runtime/flags.env
LIUSHA_TRANSCRIPT_DIR=/srv/liusha-runtime/transcripts
